# NEON RUSH - environment template.
#
# Copy to .env for local development:  cp .env.example .env
# Every value below is optional; the game runs with none of them set.

# Port to bind. Most hosts inject this automatically - when it is set the
# server also binds 0.0.0.0 and skips opening a browser.
PORT=8080

# Bind address. Defaults to 127.0.0.1 locally, or 0.0.0.0 when PORT is set.
# HOST=0.0.0.0

# Database.
#
# DATABASE_URL accepts:
#   - PostgreSQL: postgresql://... or postgres://...
#   - SQLite: sqlite:///path or a bare filesystem path
#
# For local development use the SQLite default below. For deployment (Neon,
# Render, etc.) replace it with the PostgreSQL connection string.
#
#   NEONRUSH_DB=/app/data/neonrush.sqlite3   # local SQLite
#   DATABASE_URL=sqlite:///./data/neonrush.sqlite3
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./data/neonrush.sqlite3

# Reserved. The server authenticates with per-player bearer tokens generated by
# secrets.token_urlsafe and stores only their hashes, so there is no signing key
# to configure. Present because deploy templates commonly expect it.
# SECRET_KEY=
